# Copy to .env and adjust the values before running docker compose up.

POSTGRES_USER=porttorch
POSTGRES_PASSWORD=change-me
POSTGRES_DB=porttorch

# Must match the POSTGRES_* values above (host "postgres" is the compose service name)
DATABASE_URL=postgres://porttorch:change-me@postgres:5432/porttorch

# Long random string, e.g. generate with: openssl rand -hex 32
SESSION_SECRET=change-me-generate-a-long-random-string

# Initial dashboard login, created/updated on startup
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

PORT=8443

# Structured JSON logging on stdout (see src/logger.ts). Can be picked up
# by the container log driver and forwarded to a SIEM.
# Values: trace|debug|info|warn|error|fatal
LOG_LEVEL=info

# Hosts not seen (last_seen_at) in this many days are purged automatically,
# along with all their history (ports, screenshots, tags, comments,
# certificates). Checked hourly. Set to 0 to disable. This only seeds the
# value once, at first migration - after that it's live-editable from the
# Settings page (admin only), not read from this env var again.
HOST_RETENTION_DAYS=180

# Optional. Raises the NVD API rate limit (CVE correlation sync, see
# src/cve/sync.ts) from 5 to 50 requests/30s. Get one free at
# https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# A scan_job stuck "running" (with no recent progress heartbeat - a
# genuinely slow-but-alive scan doesn't count) or a scan_request stuck
# "pending"/"claimed" for longer than this many minutes is flagged "stale"
# in the dashboard (Active scans banner, Scanner Agents page, host
# detail's last rescan line) - usually means the scanner that owns it is
# offline or died mid-scan. Purely a display hint; nothing is deleted or
# reassigned. This only seeds the value once, at first migration - after
# that it's live-editable from the Settings page (admin only), not read
# from this env var again.
STALE_SCAN_THRESHOLD_MINUTES=60

# Optional, and only read ONCE - on the upgrade that added SMTP to
# app_settings (migration 1743600000000), to seed those columns from an
# existing deployment's working configuration. From then on the mail
# server is configured live under Admin -> Settings, and editing these
# has no effect. A fresh install can leave them blank and configure it in
# the dashboard instead. Only needed at all if you create an "email"
# alert channel on the Webhooks page.
SMTP_HOST=
SMTP_PORT=587
# true for implicit-TLS ports like 465; leave false for STARTTLS on 587.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Defaults to SMTP_USER if unset.
SMTP_FROM=

# A CVE's EPSS score (exploit prediction, synced daily - see
# src/cve/epssSync.ts) at or above this fires a "vulnerability.high_epss"
# webhook once per CVE. 0.5 = 50% predicted exploit probability in the next
# 30 days.
EPSS_ALERT_THRESHOLD=0.5

# UTC hour (0-23) the daily digest email fires at, if any webhook/email
# channel is subscribed to the "digest.daily" event on the Webhooks page.
DIGEST_EMAIL_HOUR_UTC=8

# Per-token request cap for the External API (/api/v1), per minute. Every
# call there runs real fleet-wide SQL, so this bounds a runaway or
# misconfigured integration; a normal SOAR client reacts to events rather
# than polling and stays far below it. Set to 0 to disable the limit
# entirely. Counted per token, not per source IP - see
# server/src/apiTokens/rateLimit.ts.
API_TOKEN_RATE_LIMIT_PER_MINUTE=120

# Bearer token guarding GET /metrics (Prometheus exposition). Leaving this
# unset disables that endpoint entirely - it reveals fleet shape (host and
# scanner counts, queue depths), so it is fail-closed rather than open by
# default. GET /healthz needs no token and is always available.
METRICS_TOKEN=
