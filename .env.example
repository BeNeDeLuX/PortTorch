# Copy to .env and adjust the values before running docker compose up.

POSTGRES_USER=porttorch
POSTGRES_PASSWORD=change-me
POSTGRES_DB=porttorch

# Must match the POSTGRES_* values above (host "postgres" is the compose service name)
DATABASE_URL=postgres://porttorch:change-me@postgres:5432/porttorch

# Long random string, e.g. generate with: openssl rand -hex 32
SESSION_SECRET=change-me-generate-a-long-random-string

# Initial dashboard login, created/updated on startup
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

PORT=8443

# Structured JSON logging on stdout (see src/logger.ts). Can be picked up
# by the container log driver and forwarded to a SIEM.
# Values: trace|debug|info|warn|error|fatal
LOG_LEVEL=info

# Hosts not seen (last_seen_at) in this many days are purged automatically,
# along with all their history (ports, screenshots, tags, comments,
# certificates). Checked hourly. Set to 0 to disable.
HOST_RETENTION_DAYS=180

# Optional. Raises the NVD API rate limit (CVE correlation sync, see
# src/cve/sync.ts) from 5 to 50 requests/30s. Get one free at
# https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# A scan_job stuck "running" or a scan_request stuck "pending"/"claimed"
# for longer than this many minutes is flagged "stale" in the dashboard
# (Active scans banner, Scanner Agents page, host detail's last rescan
# line) - usually means the scanner that owns it is offline or died
# mid-scan. Purely a display hint; nothing is deleted or reassigned.
STALE_SCAN_THRESHOLD_MINUTES=60

# Optional. Only needed if you create an "email" alert channel on the
# Webhooks page (in addition to, or instead of, the existing Slack/Discord-
# style webhook channels) - see src/webhooks/email.ts. Leave unset if you
# only ever use webhook channels.
SMTP_HOST=
SMTP_PORT=587
# true for implicit-TLS ports like 465; leave false for STARTTLS on 587.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Defaults to SMTP_USER if unset.
SMTP_FROM=

# A CVE's EPSS score (exploit prediction, synced daily - see
# src/cve/epssSync.ts) at or above this fires a "vulnerability.high_epss"
# webhook once per CVE. 0.5 = 50% predicted exploit probability in the next
# 30 days.
EPSS_ALERT_THRESHOLD=0.5

# UTC hour (0-23) the daily digest email fires at, if any webhook/email
# channel is subscribed to the "digest.daily" event on the Webhooks page.
DIGEST_EMAIL_HOUR_UTC=8
